// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Series {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  coverUrl       String?
  description    String?
  shootDate      DateTime?
  shootDateLabel String?
  referenceUrl   String?
  linkedTicketId String?
  linkedTicket   Ticket?  @relation("SeriesLinkedTicket", fields: [linkedTicketId], references: [id], onDelete: SetNull)
  visibility     String   @default("private") // "public" | "private"
  featured       Boolean  @default(false)
  tags           String[] @default([])
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photos Photo[]
  featuredWorks FeaturedWork[]

  @@map("series")
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  key       String
  order     Int      @default(0)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @default("")
  excerpt     String?
  coverUrl    String?
  coverKey    String?
  status      String   @default("draft") // "draft" | "published"
  tags        String[] @default([])
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  linkedSeries Series[] @relation("SeriesLinkedTicket")

  @@map("tickets")
}

model Profile {
  id          String   @id @default(cuid())
  name        String   @default("Christian Ramade")
  tagline     String   @default("Observing the Unseen.")
  bio         String   @default("")
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timeline TimelineItem[]
  books    Book[]

  @@map("profiles")
}

model TimelineItem {
  id          String   @id @default(cuid())
  title       String
  year        String
  description String?
  location    String?
  order       Int      @default(0)
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_items")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  publisher   String?
  year        String?
  description String?
  coverUrl    String?
  coverKey    String?
  order       Int      @default(0)
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("books")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Homepage {
  id            String   @id @default(cuid())
  heroImageUrl  String?
  heroImageKey  String?
  heroText      String   @default("")
  presentation  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  featuredWorks FeaturedWork[]

  @@map("homepages")
}

model FeaturedWork {
  id         String   @id @default(cuid())
  url        String
  key        String
  order      Int      @default(0)
  homepageId String
  homepage   Homepage @relation(fields: [homepageId], references: [id], onDelete: Cascade)
  seriesId   String?
  series     Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("featured_works")
}
